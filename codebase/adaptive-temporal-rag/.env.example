# Answer backend: extractive | api | hf
GENERATOR_BACKEND=api

# Failover order when GENERATOR_BACKEND=api (skip providers with missing keys)
LLM_PROVIDER_ORDER=groq,openrouter,opencode

# --- Groq ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenRouter (used when Groq rate-limits / fails) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://localhost
# OPENROUTER_APP_NAME=AdaptiveTemporalRAG

# --- OpenCode Console / Zen (OpenAI-compatible) ---
OPENCODE_API_KEY=your_opencode_key_here
OPENCODE_MODEL=opencode/gpt-5-nano
# Set to your Console gateway base URL (no trailing /chat/completions)
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
