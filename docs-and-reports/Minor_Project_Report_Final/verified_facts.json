 "source_commit": "44938a7 (master) - 'Add a TempRALM-style decay baseline and paired significance on the frozen eval.'",
 "repo": "D:\\Documents\\Adaptive-Temporal-RAG-Laptop-Transfer\\codebase\\adaptive-temporal-rag",
 "team": {
  "student": "Daksh Agarwal",
